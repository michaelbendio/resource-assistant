#!/usr/bin/env python3
"""Build an isolated review HTML from a historical package; never publish an office."""
import argparse
import base64
import html
import json
from pathlib import Path
import re
import subprocess
import zipfile

root = Path(__file__).resolve().parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('package', type=Path)
parser.add_argument('output', type=Path)
args = parser.parse_args()
with zipfile.ZipFile(args.package) as archive:
    package = json.loads(archive.read('tso-resources.json'))
    pdfs = {name: base64.b64encode(archive.read(name)).decode() for name in archive.namelist() if name.lower().endswith('.pdf')}
args.output.parent.mkdir(parents=True, exist_ok=True)
subprocess.run(['python3', str(root/'make-local-tso'), 'provo-scout-3c-preview', '--output', str(args.output)], check=True, cwd=root)
page = args.output.read_text()
seed = json.dumps(package, ensure_ascii=False).replace('<', '\\u003c')
page = re.sub(r'(<script id="seed-data" type="application/json">).*?(</script>)', lambda m: m[1]+seed+m[2], page, count=1, flags=re.S)
banner = '<aside style="padding:12px;background:#fff3cd;color:#332600" class="scout-preview-banner"><strong>Scout 3C simplified navigation preview</strong> — Historical Provo package '+str(package.get('packageVersion'))+'. Navigation review only. Category retirements and new research proposals have not been applied. Changes here stay in this preview.</aside>'
page = page.replace('<body>', '<body>'+banner, 1)
# Provision exact original PDF bytes into the isolated preview asset database.
script = '''<script>
window.scoutPreviewAssetsReady = (async () => {
 const assets = ASSETS;
 for(const [path, encoded] of Object.entries(assets)){
   const bytes = Uint8Array.from(atob(encoded), char => char.charCodeAt(0));
   await savePDF(path, new Blob([bytes], {type:"application/pdf"}));
 }
})().catch(error => { console.error("Preview PDF initialization failed", error); });
</script>'''.replace('ASSETS', json.dumps(pdfs))
page = page.replace('</body>',script+'\n</body>',1)
page = page.replace('</head>', '<style>@media print {.scout-preview-banner {display:none !important;}}</style>\n</head>',1)
args.output.write_text(page)
print(f'Preview: {args.output}; {len(package["resources"])} historical resources; {len(pdfs)} original PDFs; isolated browser storage.')
