#!/usr/bin/env python3
"""Generate a local TSO HTML file from new.html.

Usage:
  python3 make-local-tso albuquerque
  python3 make-local-tso salt-lake
  python3 make-local-tso utah_valley --output albq.html

The script copies new.html, sets the tso-storage-id meta tag, updates the page
title, and overwrites the destination HTML file if it already exists. Copying an
office file to a personal sync folder or removable drive is a separate action.
"""
from __future__ import annotations

import argparse
import html as html_module
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, urlencode


def slugify(value: str) -> str:
    parts = re.findall(r"[A-Za-z0-9]+", value.strip())
    if not parts:
        raise SystemExit("TSO name must contain at least one letter or number.")
    return "-".join(part.lower() for part in parts)


def display_name(value: str) -> str:
    parts = re.findall(r"[A-Za-z0-9]+", value.strip())
    if not parts:
        raise SystemExit("TSO name must contain at least one letter or number.")
    return " ".join(part[:1].upper() + part[1:].lower() for part in parts)


def sharepoint_package_url(storage_id: str, office_name: str) -> str:
    office_folder = f"{office_name} TSO"
    parent_path = f"/sites/WSR_TSO/{office_folder}"
    package_path = f"{parent_path}/{storage_id}-resource-package.zip"
    page_path = f"/sites/WSR_TSO/{quote(office_folder)}/Forms/AllItems.aspx"
    return (
        f"https://churchofjesuschrist.sharepoint.com{page_path}?"
        f"{urlencode({'id': package_path, 'parent': parent_path})}"
    )


def replace_once(pattern: str, replacement: str, text: str, description: str) -> str:
    updated, count = re.subn(pattern, replacement, text, count=1, flags=re.IGNORECASE)
    if count != 1:
        raise SystemExit(f"Could not update {description}; expected exactly one match.")
    return updated


def main() -> int:
    parser = argparse.ArgumentParser(description="Create a local TSO HTML file from new.html.")
    parser.add_argument("name", help="Local TSO name, such as albuquerque or salt-lake")
    parser.add_argument("--output", "-o", help="Destination HTML file. Defaults to <name>.html")
    parser.add_argument("--source", "-s", help="Template HTML file. Defaults to new.html")
    args = parser.parse_args()

    storage_id = slugify(args.name)
    title_name = display_name(args.name)
    sharepoint_url = sharepoint_package_url(storage_id, title_name)
    source_path = Path(args.source) if args.source else Path(__file__).resolve().parent / "new.html"
    destination_path = Path(args.output or f"{storage_id}.html")

    if args.source is None:
        builder = Path(__file__).resolve().parent / "build-tso-resources"
        subprocess.run([sys.executable, str(builder)], check=True)

    if not source_path.exists():
        raise SystemExit(f"Template not found: {source_path}")
    if source_path.resolve() == destination_path.resolve():
        raise SystemExit("Refusing to overwrite the master template with a local TSO file.")

    html = source_path.read_text(encoding="utf-8")
    html = replace_once(
        r'<meta\s+name=["\']tso-storage-id["\']\s+content=["\'][^"\']*["\']\s*>',
        f'<meta name="tso-storage-id" content="{storage_id}">',
        html,
        "tso-storage-id meta tag",
    )
    html = replace_once(
        r'<meta\s+name=["\']tso-office-name["\']\s+content=["\'][^"\']*["\']\s*>',
        f'<meta name="tso-office-name" content="{html_module.escape(title_name, quote=True)}">',
        html,
        "tso-office-name meta tag",
    )
    html = replace_once(
        r'<meta\s+name=["\']tso-sharepoint-package-url["\']\s+content=["\'][^"\']*["\']\s*>',
        f'<meta name="tso-sharepoint-package-url" content="{html_module.escape(sharepoint_url, quote=True)}">',
        html,
        "tso-sharepoint-package-url meta tag",
    )
    html = replace_once(
        r"<title>.*?</title>",
        f"<title>{title_name} TSO Resources</title>",
        html,
        "page title",
    )

    destination_path.write_text(html, encoding="utf-8")
    print(
        f"Wrote {destination_path} with storage id {storage_id!r}, "
        f"title {title_name!r}, and embedded SharePoint package URL."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
