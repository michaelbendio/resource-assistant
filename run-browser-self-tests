#!/usr/bin/env python3
"""Run the debug HTML self-tests in an installed Chromium browser."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from html.parser import HTMLParser
from pathlib import Path


ROOT = Path(__file__).resolve().parent
DEBUG_HTML = ROOT / "build" / "tso-resources-debug.html"


class SelfTestResultsParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.results_depth = 0
        self.current_row: list[str] | None = None
        self.rows: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        attributes = dict(attrs)
        if not self.results_depth and attributes.get("id") == "selfTestResults":
            self.results_depth = 1
            return
        if not self.results_depth:
            return
        self.results_depth += 1
        if self.results_depth == 2 and tag == "div":
            self.current_row = []

    def handle_data(self, data: str) -> None:
        if self.current_row is not None:
            self.current_row.append(data)

    def handle_endtag(self, tag: str) -> None:
        if not self.results_depth:
            return
        if self.results_depth == 2 and tag == "div" and self.current_row is not None:
            self.rows.append("".join(self.current_row).strip())
            self.current_row = None
        self.results_depth -= 1


def browser_candidates() -> list[Path]:
    candidates: list[Path] = []
    configured = os.environ.get("TSO_BROWSER", "").strip()
    if configured:
        candidates.append(Path(configured).expanduser())

    for command in (
        "msedge",
        "microsoft-edge",
        "microsoft-edge-stable",
        "google-chrome",
        "google-chrome-stable",
        "chromium",
        "chromium-browser",
    ):
        located = shutil.which(command)
        if located:
            candidates.append(Path(located))

    if sys.platform == "win32":
        for variable, suffix in (
            ("PROGRAMFILES(X86)", "Microsoft/Edge/Application/msedge.exe"),
            ("PROGRAMFILES", "Microsoft/Edge/Application/msedge.exe"),
            ("LOCALAPPDATA", "Microsoft/Edge/Application/msedge.exe"),
            ("PROGRAMFILES", "Google/Chrome/Application/chrome.exe"),
            ("PROGRAMFILES(X86)", "Google/Chrome/Application/chrome.exe"),
            ("LOCALAPPDATA", "Google/Chrome/Application/chrome.exe"),
        ):
            base = os.environ.get(variable)
            if base:
                candidates.append(Path(base) / suffix)
    elif sys.platform == "darwin":
        candidates.extend(
            [
                Path("/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"),
                Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"),
                Path("/Applications/Chromium.app/Contents/MacOS/Chromium"),
            ]
        )

    unique: list[Path] = []
    seen: set[str] = set()
    for candidate in candidates:
        key = str(candidate).lower() if sys.platform == "win32" else str(candidate)
        if key in seen:
            continue
        seen.add(key)
        unique.append(candidate)
    return unique


def find_browser(explicit: Path | None = None) -> Path:
    candidates = [explicit.expanduser()] if explicit else browser_candidates()
    for candidate in candidates:
        if candidate and candidate.is_file():
            return candidate.resolve()
    if explicit:
        raise RuntimeError(f"Browser executable was not found: {explicit}")
    raise RuntimeError(
        "Microsoft Edge, Google Chrome, or Chromium is required to run browser self-tests. "
        "Install one or set TSO_BROWSER to its executable path."
    )


def parse_self_test_rows(document: str) -> list[str]:
    parser = SelfTestResultsParser()
    parser.feed(document)
    return parser.rows


def run_browser_self_tests(browser: Path, timeout: int) -> list[str]:
    if not DEBUG_HTML.is_file():
        raise RuntimeError(
            f"Debug build is missing: {DEBUG_HTML}. Run build-tso-resources --with-tests first."
        )

    url = f"{DEBUG_HTML.resolve().as_uri()}?self-tests=1"
    arguments = [
        str(browser),
        "--headless=new",
        "--disable-gpu",
        "--no-first-run",
        "--no-default-browser-check",
        "--virtual-time-budget=10000",
    ]
    if "edge" in browser.name.lower():
        # Edge otherwise relaunches itself on Windows and detaches from the
        # stdout pipe used by --dump-dom.
        arguments.append("--edge-skip-compat-layer-relaunch")

    with tempfile.TemporaryDirectory(prefix="tso-browser-tests-") as profile:
        arguments.extend([f"--user-data-dir={profile}", "--dump-dom", url])
        try:
            completed = subprocess.run(
                arguments,
                capture_output=True,
                check=False,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as error:
            raise RuntimeError(
                f"Browser self-tests did not finish within {timeout} seconds. "
                "A browser prompt may be blocking the test suite."
            ) from error

    document = completed.stdout.decode("utf-8", errors="replace")
    rows = parse_self_test_rows(document)
    if completed.returncode != 0:
        stderr = completed.stderr.decode("utf-8", errors="replace").strip()
        detail = f"\n{stderr[-2000:]}" if stderr else ""
        raise RuntimeError(f"Browser exited with status {completed.returncode}.{detail}")
    if not rows:
        raise RuntimeError("Browser self-tests produced no results.")
    return rows


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--browser", type=Path, help="Edge, Chrome, or Chromium executable")
    parser.add_argument("--timeout", type=int, default=60, help="Browser timeout in seconds")
    args = parser.parse_args()

    try:
        browser = find_browser(args.browser)
        rows = run_browser_self_tests(browser, args.timeout)
    except (OSError, RuntimeError) as error:
        print(f"BROWSER SELF-TESTS FAILED: {error}", file=sys.stderr)
        return 1

    failures = [row for row in rows if row.startswith("✖ FAIL")]
    passes = [row for row in rows if row.startswith("✔ PASS")]
    unknown = [row for row in rows if row not in failures and row not in passes]
    if failures or unknown:
        for row in failures + unknown:
            print(row, file=sys.stderr)
        print(
            f"BROWSER SELF-TESTS FAILED: {len(passes)} passed, "
            f"{len(failures)} failed, {len(unknown)} unrecognized.",
            file=sys.stderr,
        )
        return 1

    print(f"BROWSER SELF-TESTS PASSED: {len(passes)} passed using {browser.name}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
